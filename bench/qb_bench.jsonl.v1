{"quote_id": "2020-03-28-036818", "split": "train", "variant_ids": ["2020-03-28-036818"], "speaker": "Gladys Berejiklian", "quotation": "We understand some people have had a very stressful time trying to get back home and we want to consider their position, but we also need to consider the health and safety of eight million residents in NSW and also more broadly, 25 million people in Australia.", "n_domains": 30, "as_of": "2020-03-29T04:43:56", "query_url": "https://www.9news.com.au/national/coronavirus-hotel-quarantine-grave-concerns-for-elderly-as-hotel-health-checks-dry-up/27bef0d5-6704-4e14-bb8d-98608ed46c24", "verbatim": "Gladys Berejiklian said: \"We understand some people have had a very stressful time trying to get back home and we want to consider their position, but we also need to consider the health and safety of eight million residents in NSW and also more broadly, 25 million people in Australia.\"", "paraphrase": "Gladys Berejiklian said authorities understood that some people had found it very stressful to get home and that they wanted to weigh their situation, but said they also had to weigh the health and safety of eight million people in New South Wales and, more broadly, 25 million Australians.", "gt_first_any": {"date": "2020-03-28T04:41:43", "domain": "armidaleexpress.com.au", "url": "http://armidaleexpress.com.au/story/6701438/nsw-premier-to-hotel-quarantined-be-calm/?cs=7", "has_time": true}, "gt_first_original": {"date": "2020-03-28T04:41:43", "domain": "armidaleexpress.com.au", "url": "http://armidaleexpress.com.au/story/6701438/nsw-premier-to-hotel-quarantined-be-calm/?cs=7"}}
