{"quote_id": "2020-01-31-003407", "split": "train", "variant_ids": ["2020-01-31-003407", "2020-02-06-003595", "2020-02-07-003434"], "speaker": "Vicky Kaushal", "quotation": "After spending countless hours at the crematorium (for a movie), I realised the importance of existence. Everybody has to face reality that is death. So after being called fat, ugly or dark, at the end of the journey we all are the same -- ashes,", "n_domains": 5, "as_of": "2020-02-05T21:09:52", "query_url": "https://www.newsgram.com/vicky-kaushal-believes-being-gay-most-natural-ever/#respond", "verbatim": "Vicky Kaushal said: \"After spending countless hours at the crematorium (for a movie), I realised the importance of existence. Everybody has to face reality that is death. So after being called fat, ugly or dark, at the end of the journey we all are the same -- ashes,\"", "paraphrase": "Vicky Kaushal said that after spending countless hours at a crematorium while preparing for a movie, he came to realise the importance of existence, adding that everyone must confront the reality of death and that, after being insulted over their weight, appearance or skin colour, everyone ends up the same at the journey's end as ashes.", "gt_first_any": {"date": "2020-02-05T13:51:01", "domain": "prokerala.com", "url": "https://www.prokerala.com/news/articles/a1004737.html", "has_time": true}, "gt_first_original": {"date": "2020-02-05T14:15:09", "domain": "daijiworld.com", "url": "http://daijiworld.com/news/newsDisplay.aspx?newsID=671169"}}
