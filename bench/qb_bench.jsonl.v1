{"quote_id": "2020-03-27-033773", "split": "train", "variant_ids": ["2020-03-27-033773", "2020-03-27-076995", "2020-03-27-016324", "2020-03-27-068550", "2020-03-29-002447", "2020-03-27-033771", "2020-03-27-076996", "2020-03-27-033772", "2020-03-27-033769", "2020-03-27-033770"], "speaker": "Gretchen Whitmer", "quotation": "I've asked repeatedly and respectfully for help. We need it. No more political attacks, just PPEs, ventilators, N95 masks, test kits. You said you stand with Michigan -- prove it.", "n_domains": 16, "as_of": "2020-03-27T21:48:29", "query_url": "https://www.hourdetroit.com/web-exclusive/metro-detroits-latest-covid-19-updates-march-27/", "verbatim": "Gretchen Whitmer said: \"I've asked repeatedly and respectfully for help. We need it. No more political attacks, just PPEs, ventilators, N95 masks, test kits. You said you stand with Michigan -- prove it.\"", "paraphrase": "Governor Gretchen Whitmer said she had asked for help again and again in a respectful manner, stressing that the state needs personal protective equipment, ventilators, N95 masks and test kits, and she demanded that her critics stop launching political attacks and show through action that they stand behind Michigan.", "gt_first_any": {"date": "2020-03-27T11:54:51", "domain": "nbcnews.com", "url": "https://www.nbcnews.com/health/health-news/live-blog/live-coronavirus-updates-house-members-race-back-washington-trump-xi-n1170106/ncrd1170216", "has_time": true}, "gt_first_original": {"date": "2020-03-27T11:54:51", "domain": "nbcnews.com", "url": "https://www.nbcnews.com/health/health-news/live-blog/live-coronavirus-updates-house-members-race-back-washington-trump-xi-n1170106/ncrd1170216"}}
