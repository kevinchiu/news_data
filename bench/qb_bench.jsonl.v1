{"quote_id": "2020-03-20-006860", "split": "val", "variant_ids": ["2020-03-20-006860", "2020-03-20-006857", "2020-03-20-077555", "2020-03-20-077553", "2020-03-20-002902", "2020-03-24-058126", "2020-03-20-006859", "2020-03-20-002904", "2020-03-20-002901", "2020-03-20-006856", "2020-03-20-077554", "2020-03-20-002903"], "speaker": "Steven Mnuchin", "quotation": "At @realDonaldTrump's direction, we are moving Tax Day from April 15 to July 15. All taxpayers and businesses will have this additional time to file and make payments without interest or penalties.", "n_domains": 11, "as_of": "2020-03-20T13:17:21", "query_url": "https://www.forexcrunch.com/us-treasury-sec-mnuchin-tax-filing-day-to-be-moved-from-april-15-to-july-15/", "verbatim": "Steven Mnuchin said: \"At @realDonaldTrump's direction, we are moving Tax Day from April 15 to July 15. All taxpayers and businesses will have this additional time to file and make payments without interest or penalties.\"", "paraphrase": "Steven Mnuchin said that, at the president's direction, the government was pushing back the tax deadline from April 15 until July 15, giving all taxpayers and businesses extra time to file and pay without incurring interest or penalties.", "gt_first_any": {"date": "2020-03-20T07:04:14", "domain": "seattletimes.com", "url": "https://www.seattletimes.com/seattle-news/health/coronavirus-daily-news-updates-march-20-what-to-know-today-about-covid-19-in-the-seattle-area-washington-state-and-the-nation/?utm_source=RSS&utm_medium=Referral&utm_campaign=RSS_all", "has_time": true}, "gt_first_original": {"date": "2020-03-20T07:04:14", "domain": "seattletimes.com", "url": "https://www.seattletimes.com/seattle-news/health/coronavirus-daily-news-updates-march-20-what-to-know-today-about-covid-19-in-the-seattle-area-washington-state-and-the-nation/?utm_source=RSS&utm_medium=Referral&utm_campaign=RSS_all"}}
