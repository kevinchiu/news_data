{"quote_id": "2020-03-27-063041", "split": "val", "variant_ids": ["2020-03-27-063041"], "speaker": "Tedros Adhanom Ghebreyesus", "quotation": "Viral outbreaks are a fact of life. How much damage they do is something we can influence,", "n_domains": 5, "as_of": "2020-03-28T03:58:49", "query_url": "http://www.rappler.com/world/global-affairs/256184-chronic-global-shortage-virus-protective-gear-urgent-threat", "verbatim": "Tedros Adhanom Ghebreyesus said: \"Viral outbreaks are a fact of life. How much damage they do is something we can influence,\"", "paraphrase": "Tedros Adhanom Ghebreyesus said that virus-driven outbreaks are an inevitable part of human existence, but the extent of the harm they cause is something the world has the power to shape.", "gt_first_any": {"date": "2020-03-27T18:36:22", "domain": "medicalxpress.com", "url": "https://medicalxpress.com/news/2020-03-chronic-global-shortage-virus-gear.html", "has_time": true}, "gt_first_original": {"date": "2020-03-27T18:36:22", "domain": "medicalxpress.com", "url": "https://medicalxpress.com/news/2020-03-chronic-global-shortage-virus-gear.html"}}
