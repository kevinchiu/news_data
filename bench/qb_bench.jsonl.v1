{"quote_id": "2020-01-23-021138", "split": "test", "variant_ids": ["2020-01-23-021138", "2020-01-23-057714", "2020-01-22-012715", "2020-01-22-006160", "2020-01-22-010954", "2020-01-23-012653", "2020-01-23-021137"], "speaker": "Mark Davis", "quotation": "For today, January 22, 2020, we are now the Las Vegas Raiders. And, today, Las Vegas officially becomes our nation's capital.", "n_domains": 6, "as_of": "2020-01-22T23:45:43", "query_url": "http://www.cbssports.com/nfl/news/raiders-officially-say-goodbye-to-oakland-relocate-to-las-vegas-for-2020-and-beyond/", "verbatim": "Mark Davis said: \"For today, January 22, 2020, we are now the Las Vegas Raiders. And, today, Las Vegas officially becomes our nation's capital.\"", "paraphrase": "Mark Davis said that, as of January 22, 2020, the team had rebranded as the Raiders of Las Vegas and that Las Vegas was officially taking on the title of the nation's capital that day.", "gt_first_any": {"date": "2020-01-22T16:53:39", "domain": "sanfrancisco.cbslocal.com", "url": "https://sanfrancisco.cbslocal.com/2020/01/22/las-vegas-raiders-oaklands-former-team-officially-takes-on-new-name/", "has_time": true}, "gt_first_original": {"date": "2020-01-22T16:53:39", "domain": "sanfrancisco.cbslocal.com", "url": "https://sanfrancisco.cbslocal.com/2020/01/22/las-vegas-raiders-oaklands-former-team-officially-takes-on-new-name/"}}
