{"quote_id": "2020-03-29-019661", "split": "val", "variant_ids": ["2020-03-29-019661", "2020-03-30-037927"], "speaker": "Paul Quinn", "quotation": "Other congregations are using the internet, Skype, and other safe ways to congregate. Why can't they? What makes them so special?", "n_domains": 46, "as_of": "2020-03-29T17:25:40", "query_url": "https://thecourier.com/national-news-latest/2020/03/29/hundreds-at-louisiana-church-flout-covid-19-gatherings-ban/", "verbatim": "Paul Quinn said: \"Other congregations are using the internet, Skype, and other safe ways to congregate. Why can't they? What makes them so special?\"", "paraphrase": "Paul Quinn argued that other congregations were already making use of the internet and Skype, along with other secure alternatives, to meet, and he asked why those congregations should be denied the same option, questioning what made them exceptional.", "gt_first_any": {"date": "2020-03-29T10:52:00", "domain": "mynorthwest.com", "url": "https://mynorthwest.com/1794499/hundreds-at-church-flout-covid-19-gatherings-ban/", "has_time": true}, "gt_first_original": {"date": "2020-03-29T10:52:00", "domain": "mynorthwest.com", "url": "https://mynorthwest.com/1794499/hundreds-at-church-flout-covid-19-gatherings-ban/"}}
