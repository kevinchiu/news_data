{"quote_id": "2020-01-29-007115", "split": "val", "variant_ids": ["2020-01-29-007115"], "speaker": "Paul Taylor", "quotation": "Any room the E.U. walks into, it will carry less weight than when the U.K. was a member -- on trade, climate, defense,", "n_domains": 7, "as_of": "2020-01-30T01:00:00", "query_url": "http://www.msn.com/en-us/news/world/brexit-is-here-and-its-a-texas-size-defeat-for-the-eu/ar-BBZrLNe?srcref=rss", "verbatim": "Paul Taylor said: \"Any room the E.U. walks into, it will carry less weight than when the U.K. was a member -- on trade, climate, defense,\"", "paraphrase": "Paul Taylor said the EU would wield less influence in any forum it entered than it did while Britain belonged to the bloc, particularly on trade, climate and defense.", "gt_first_any": {"date": "2020-01-29T17:41:36", "domain": "nytimes.com", "url": "http://www.nytimes.com/2020/01/29/world/europe/brexit-brussels-eu.html", "has_time": true}, "gt_first_original": {"date": "2020-01-29T17:41:36", "domain": "nytimes.com", "url": "http://www.nytimes.com/2020/01/29/world/europe/brexit-brussels-eu.html"}}
{"quote_id": "2020-03-12-060793", "split": "val", "variant_ids": ["2020-03-12-060793", "2020-03-13-056844"], "speaker": "Michael West", "quotation": "The circumstances around our job are often an unpleasant call to service, but this picture just shows we're human like anyone else and any chance we get to serve the community and help people, we take that chance,", "n_domains": 5, "as_of": "2020-03-13T11:15:11", "query_url": "https://www.kdrv.com/content/news/568766502.html", "verbatim": "Michael West said: \"The circumstances around our job are often an unpleasant call to service, but this picture just shows we're human like anyone else and any chance we get to serve the community and help people, we take that chance,\"", "paraphrase": "Michael West said that although the conditions surrounding their work often amount to an unpleasant call to duty, the picture simply shows that they are human like everyone else, and whenever they get the opportunity to assist the community and aid people, they seize it.", "gt_first_any": {"date": "2020-03-12T23:53:01", "domain": "abc17news.com", "url": "https://abc17news.com/news/national-world/2020/03/12/a-police-officer-spent-his-lunch-break-sharing-pizza-with-a-homeless-woman-and-it-was-captured-in-a-heartwarming-photo/", "has_time": true}, "gt_first_original": {"date": "2020-03-12T23:53:01", "domain": "abc17news.com", "url": "https://abc17news.com/news/national-world/2020/03/12/a-police-officer-spent-his-lunch-break-sharing-pizza-with-a-homeless-woman-and-it-was-captured-in-a-heartwarming-photo/"}}
