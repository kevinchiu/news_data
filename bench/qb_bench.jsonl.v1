{"quote_id": "2020-02-09-007744", "split": "test", "variant_ids": ["2020-02-09-007744", "2020-02-10-012572", "2020-02-09-007745"], "speaker": "Nicos Anastasiades", "quotation": "Disputing sovereign rights or preconditions such as `I'm violating international law and in return, you must give up your sovereign rights so that we can talk' ... that doesn't demonstrate either good will or good faith,", "n_domains": 8, "as_of": "2020-02-09T19:20:32", "query_url": "https://kvia.com/your-voice-your-vote/politics/2020/02/09/cyprus-president-no-drilling-let-up-despite-turkeys-moves/", "verbatim": "Nicos Anastasiades said: \"Disputing sovereign rights or preconditions such as `I'm violating international law and in return, you must give up your sovereign rights so that we can talk' ... that doesn't demonstrate either good will or good faith,\"", "paraphrase": "Nicos Anastasiades said that disputing sovereign rights or setting preconditions, such as demanding that one side breach international law in exchange for the other surrendering its sovereign rights before talks can begin, demonstrates neither goodwill nor good faith.", "gt_first_any": {"date": "2020-02-09T11:20:32", "domain": "seattletimes.com", "url": "https://www.seattletimes.com/business/cyprus-president-no-drilling-let-up-despite-turkeys-moves/?utm_source=RSS&utm_medium=Referral&utm_campaign=RSS_all", "has_time": true}, "gt_first_original": {"date": "2020-02-09T11:20:32", "domain": "seattletimes.com", "url": "https://www.seattletimes.com/business/cyprus-president-no-drilling-let-up-despite-turkeys-moves/?utm_source=RSS&utm_medium=Referral&utm_campaign=RSS_all"}}
